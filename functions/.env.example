# Dejar comentado para que las Cloud Functions atiendan ambas bases (emuna-testing y emuna-prod).
# Si querés restringir todo a una sola base, descomentá y definí emuna-testing o emuna-prod.
# FIREBASE_DATABASE_ID=emuna-testing

# Configuración SMTP de Brevo (https://app.brevo.com -> SMTP & API -> SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=tu-usuario-smtp@smtp-brevo.com
SMTP_PASS=tu-clave-smtp-de-brevo

# Remitente y URL de la app
SMTP_FROM="Emuná Pilates <no-reply@emuna-pilates.com.ar>"
SMTP_REPLY_TO=
APP_URL=https://emuna-pilates.com.ar
