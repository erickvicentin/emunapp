rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: verifica si el usuario es el dueño del documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: verifica si el usuario tiene rol de staff / administradora
    function isStaff() {
      return isAuthenticated() && 
        (
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'staff' ||
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administradora'
        );
    }

    // Colección: usuarios (perfiles de alumnas y staff)
    match /usuarios/{userId} {
      // El usuario puede leer y escribir su propio perfil
      // El staff puede consultar usuarios
      allow read: if isAuthenticated() && (isOwner(userId) || isStaff());
      allow create, update: if isAuthenticated() && (isOwner(userId) || isStaff());
      allow delete: if isStaff();
    }

    // Colección: turnos_clase (cupos fijos de 4 camas)
    match /turnos_clase/{turnoId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Colección: reservas (vínculo entre alumna y turno)
    match /reservas/{reservaId} {
      allow read: if isAuthenticated() && (resource.data.usuarioId == request.auth.uid || isStaff());
      allow create: if isAuthenticated() && request.resource.data.usuarioId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.usuarioId == request.auth.uid || isStaff());
      allow delete: if isStaff();
    }

    // Colección: paquetes_catalogo (paquetes de 4, 8, 12 y 20 clases)
    match /paquetes_catalogo/{paqueteId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Colección: membresias_usuario (créditos y vencimientos)
    match /membresias_usuario/{membresiaId} {
      allow read: if isAuthenticated() && (resource.data.usuarioId == request.auth.uid || isStaff());
      allow write: if isStaff();
    }

    // Colección: pagos (transferencias manuales)
    match /pagos/{pagoId} {
      allow read: if isAuthenticated() && (resource.data.usuarioId == request.auth.uid || isStaff());
      allow create: if isAuthenticated() && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if isStaff();
    }
  }
}
