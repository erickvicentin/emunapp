rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario es el dueño del documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verifica si el usuario tiene rol de staff / administradora vía custom claims
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.rol in ['staff', 'administradora'] ||
        request.auth.token.staff == true ||
        request.auth.token.admin == true
      );
    }

    // Verifica que los campos inmutables no hayan sido modificados en un update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Valida un campo string opcional con longitud máxima
    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) ||
        (data[field] is string && data[field].size() <= maxLen);
    }

    // Validador de dominio para documentos de /usuarios/{userId}
    function isValidUser(data, userId) {
      return data.uid is string &&
        data.uid == userId &&
        data.rol is string &&
        data.rol in ['customer', 'staff', 'administradora'] &&
        isValidOptionalString(data, 'email', 254) &&
        isValidOptionalString(data, 'nombre', 100) &&
        isValidOptionalString(data, 'apellido', 100) &&
        isValidOptionalString(data, 'telefono', 30) &&
        isValidOptionalString(data, 'fechaNacimiento', 30) &&
        isValidOptionalString(data, 'genero', 30) &&
        isValidOptionalString(data, 'photoURL', 1000) &&
        isValidOptionalString(data, 'estado', 30) &&
        (!('registroCompleto' in data) || data.registroCompleto is bool);
    }

    // ===============================================================
    // Collections
    // ===============================================================

    // Colección: usuarios (perfiles de alumnas y staff)
    match /usuarios/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isValidUser(request.resource.data, userId) && (
        (isOwner(userId) && request.resource.data.rol == 'customer') ||
        isStaff()
      );
      allow update: if isValidUser(request.resource.data, userId) && (
        (isOwner(userId) && areImmutableFieldsUnchanged(['rol', 'uid'])) ||
        isStaff()
      );
      allow delete: if isStaff();
    }

    // Colección: turnos_clase (cupos fijos de 4 camas)
    match /turnos_clase/{turnoId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Colección: reservas (vínculo entre alumna y turno)
    match /reservas/{reservaId} {
      allow read: if isAuthenticated() && (resource.data.usuarioId == request.auth.uid || isStaff());
      allow create: if isAuthenticated() &&
        request.resource.data.usuarioId is string &&
        request.resource.data.usuarioId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.usuarioId == request.auth.uid && areImmutableFieldsUnchanged(['usuarioId'])) ||
        isStaff()
      );
      allow delete: if isStaff();
    }

    // Colección: paquetes_catalogo (paquetes de 4, 8, 12 y 20 clases)
    match /paquetes_catalogo/{paqueteId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Colección: membresias_usuario (créditos y vencimientos)
    match /membresias_usuario/{membresiaId} {
      allow read: if isAuthenticated() && (resource.data.usuarioId == request.auth.uid || isStaff());
      allow write: if isStaff();
    }

    // Colección: pagos (transferencias manuales)
    match /pagos/{pagoId} {
      allow read: if isAuthenticated() && (resource.data.usuarioId == request.auth.uid || isStaff());
      allow create: if isAuthenticated() &&
        request.resource.data.usuarioId is string &&
        request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if isStaff();
    }
  }
}
