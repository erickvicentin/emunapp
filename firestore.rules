rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario es el dueño del documento
    function isOwner(userId) {
      return isAuthenticated() && isActiveUser() && request.auth.uid == userId;
    }

    // Verifica si el usuario autenticado está activo (active != false)
    function isActiveUser() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.active != false;
    }

    // Verifica si el usuario tiene rol de staff / administradora vía custom claims
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.rol in ['staff', 'administradora'] ||
        request.auth.token.staff == true ||
        request.auth.token.admin == true
      );
    }

    // Verifica si el usuario tiene rol de administradora vía custom claims
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.rol == 'administradora' ||
        request.auth.token.admin == true
      );
    }

    // Verifica que los campos inmutables no hayan sido modificados en un update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Valida un campo string opcional con longitud máxima
    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) ||
        (data[field] is string && data[field].size() <= maxLen);
    }

    // Validador de dominio para documentos de /usuarios/{userId}
    function isValidUser(data, userId) {
      return data.uid is string &&
        data.uid == userId &&
        data.rol is string &&
        data.rol in ['customer', 'staff', 'administradora'] &&
        isValidOptionalString(data, 'email', 254) &&
        isValidOptionalString(data, 'nombre', 100) &&
        isValidOptionalString(data, 'apellido', 100) &&
        isValidOptionalString(data, 'telefono', 30) &&
        isValidOptionalString(data, 'fechaNacimiento', 30) &&
        isValidOptionalString(data, 'genero', 30) &&
        isValidOptionalString(data, 'photoURL', 1000) &&
        isValidOptionalString(data, 'estado', 30) &&
        (!('registroCompleto' in data) || data.registroCompleto is bool) &&
        (!('active' in data) || data.active is bool);
    }

    // Validador de dominio para documentos de /paquetes_catalogo/{paqueteId}
    function isValidPackage(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80 &&
        data.classesCount is int && data.classesCount >= 1 && data.classesCount <= 100 &&
        data.numericPrice is number && data.numericPrice >= 0 &&
        (!('validityDays' in data) || (data.validityDays is int && data.validityDays >= 1 && data.validityDays <= 365)) &&
        (!('active' in data) || data.active is bool) &&
        (!('isPopular' in data) || data.isPopular is bool) &&
        (!('isProtected' in data) || data.isProtected is bool) &&
        isValidOptionalString(data, 'category', 80) &&
        isValidOptionalString(data, 'frequency', 80) &&
        isValidOptionalString(data, 'price', 40);
    }

    // Validador de dominio para documentos de /horarios_base/{slotId}
    function isValidBaseScheduleSlot(data) {
      return data.dayOfWeek is int &&
        data.dayOfWeek >= 0 &&
        data.dayOfWeek <= 6 &&
        data.startTime is string &&
        data.durationMinutes is int &&
        data.durationMinutes >= 15 &&
        data.durationMinutes <= 180;
    }

    // Validador de dominio para documentos de /dias_cerrados/{dateKey}
    function isValidClosedDay(data) {
      return data.dateKey is string &&
        data.dateKey.size() == 10 &&
        isValidOptionalString(data, 'reason', 120);
    }

    // Validador de dominio para documentos de /reservas/{reservaId}
    function isValidReservation(data) {
      return data.usuarioId is string &&
        data.usuarioId.size() > 0 &&
        data.usuarioId.size() <= 128 &&
        data.turnoId is string &&
        data.turnoId.size() > 0 &&
        data.turnoId.size() <= 128 &&
        data.dateKey is string &&
        data.dateKey.size() == 10 &&
        data.startTime is string &&
        data.startTime.size() > 0 &&
        data.startTime.size() <= 10 &&
        data.estado is string &&
        data.estado in ['confirmada', 'cancelada', 'cancelado_estudio', 'cancelado_tiempo', 'cancelado_tarde'];
    }

    // ===============================================================
    // Collections
    // ===============================================================

    // Colección: usuarios (perfiles de alumnas y staff)
    match /usuarios/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isValidUser(request.resource.data, userId) && (
        (isOwner(userId) &&
          request.resource.data.rol == 'customer' &&
          (!('active' in request.resource.data) || request.resource.data.active == true)) ||
        (isStaff() && request.resource.data.rol == 'customer') ||
        isAdmin()
      );
      allow update: if isValidUser(request.resource.data, userId) && (
        (isOwner(userId) && areImmutableFieldsUnchanged(['rol', 'uid', 'active'])) ||
        (isStaff() && resource.data.rol == 'customer' && request.resource.data.rol == 'customer') ||
        isAdmin()
      );
      allow delete: if (isStaff() && resource.data.rol == 'customer') || isAdmin();
    }

    // Colección: turnos_clase (cupos fijos de 4 camas)
    match /turnos_clase/{turnoId} {
      allow read: if isStaff() || isActiveUser();
      allow write: if isStaff();
    }

    // Colección: reservas (vínculo entre alumna y turno)
    match /reservas/{reservaId} {
      allow read: if isAuthenticated() && (resource.data.usuarioId == request.auth.uid || isStaff());
      allow create: if isValidReservation(request.resource.data) && (
        isStaff() ||
        (isActiveUser() && request.resource.data.usuarioId == request.auth.uid)
      );
      allow update: if isValidReservation(request.resource.data) && isAuthenticated() && (
        (resource.data.usuarioId == request.auth.uid && areImmutableFieldsUnchanged(['usuarioId'])) ||
        isStaff()
      );
      allow delete: if isStaff();
    }

    // Colección: paquetes_catalogo (paquetes de 4, 8, 12 y 20 clases)
    match /paquetes_catalogo/{paqueteId} {
      allow read: if isStaff() || isActiveUser();
      allow create: if isAdmin() && isValidPackage(request.resource.data);
      allow update: if isAdmin() && isValidPackage(request.resource.data) &&
        (resource.data.get('isProtected', false) != true || request.resource.data.get('isProtected', false) == true);
      allow delete: if isAdmin() && resource.data.get('isProtected', false) != true;
    }

    // Colección: membresias_usuario (créditos y vencimientos)
    match /membresias_usuario/{membresiaId} {
      allow read: if isStaff() || (isActiveUser() && resource.data.usuarioId == request.auth.uid);
      allow write: if isStaff();
    }

    // Colección: pagos (transferencias manuales)
    match /pagos/{pagoId} {
      allow read: if isStaff() || (isActiveUser() && resource.data.usuarioId == request.auth.uid);
      allow create: if isActiveUser() &&
        request.resource.data.usuarioId is string &&
        request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if isStaff();
    }

    // Colección: horarios_base (plantilla semanal recurrente de horarios de clase)
    match /horarios_base/{slotId} {
      allow read: if isStaff() || isActiveUser();
      allow create, update: if isAdmin() && isValidBaseScheduleSlot(request.resource.data);
      allow delete: if isAdmin();
    }

    // Colección: dias_cerrados (feriados y días sin actividad del estudio)
    match /dias_cerrados/{dateKey} {
      allow read: if isStaff() || isActiveUser();
      allow create, update: if isAdmin() && isValidClosedDay(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
